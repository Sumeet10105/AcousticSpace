# ==============================================================================
# AcousticSpace - Production-Ready Git Ignore Configuration
# Custom-built specifically for this repository's structure and technologies.
# ==============================================================================

# ==========================================
# 1. Source Code & Configuration Protection
# ==========================================
# Ensure core python modules, configs, tests, notebooks, and docs are NEVER ignored.
!/.gitignore
!/README.md
!/LICENSE
!/requirements.txt
!/pyproject.toml
!/Dockerfile
!/docker-compose.yml
!/configs/
!/configs/**
!/docs/
!/docs/**
!/src/
!/src/**
!/tests/
!/tests/**
!/notebooks/
!/notebooks/**

# ==========================================
# 2. Python & Runtime Caches
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.cache/
.tox/
.nox/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
*.pid
instance/

# ==========================================
# 3. Virtual Environments
# ==========================================
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ==========================================
# 4. Environment Variables & Secrets
# ==========================================
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12

# ==========================================
# 5. IDE & Operating System Files
# ==========================================
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.bak
*.old
*.orig
*.tmp
temp/
tmp/

# ==========================================
# 6. Jupyter Notebook Checkpoints
# ==========================================
.ipynb_checkpoints/

# ==========================================
# 7. Dataset Directory Structure
# ==========================================
# Ignore all files inside the datasets subdirectories, but keep the folder structure using .gitkeep.
datasets/raw/*
!datasets/raw/.gitkeep

datasets/processed/*
!datasets/processed/.gitkeep

datasets/cache/*
!datasets/cache/.gitkeep

datasets/tmp/*
!datasets/tmp/.gitkeep

datasets/metadata/*
!datasets/metadata/.gitkeep

# Ignore specific large dataset downloads
datasets/raw/ASVspoof2019/
datasets/raw/ASVspoof2021/
datasets/raw/LA/
datasets/raw/PA/
datasets/raw/DF/

# Ignore audio processed subfolders
datasets/processed/audio/
datasets/processed/features/
datasets/processed/mfcc/
datasets/processed/mels/
datasets/processed/spectrograms/
datasets/processed/waveforms/

# ==========================================
# 8. Machine Learning Models & Checkpoints
# ==========================================
# Models, weights, and scaler checkpoints should not be committed to Git due to size and dynamic nature.
# Track directories only, ignore files.
models/*
!models/.gitkeep

best_model/*
!best_model/.gitkeep

saved_models/checkpoints/*
!saved_models/checkpoints/.gitkeep

checkpoints/
*.pt
*.pth
*.ckpt
*.bin
*.onnx
*.joblib
*.pkl
*.pickle
*.safetensors

# ==========================================
# 9. Machine Learning Cache & Experiments
# ==========================================
.huggingface/
hf_cache/
.cache/huggingface/
transformers_cache/
torch_cache/
*.pt.tmp
features_cache/
feature_cache/
runs/
tensorboard/
experiments/
mlruns/
wandb/

# ==========================================
# 10. Generated Visualizations & Reports
# ==========================================
# Keep reports and plots directories tracked via .gitkeep but ignore the generated files.
reports/*
!reports/.gitkeep

plots/*
!plots/.gitkeep

figures/*
!figures/.gitkeep

# ==========================================
# 11. Docker & Deployments
# ==========================================
docker-compose.override.yml

# ==========================================
# 12. Databases & Frontend Caches
# ==========================================
*.sqlite3
node_modules/
.next/
out/
dist/